Name: libavdevice
Description: FFmpeg device handling library
Version: 63.1.101
Requires: libavfilter >= 12.1.101, libswscale >= 10.1.101, libavformat >= 63.1.101, libavcodec >= 63.1.101, libswresample >= 7.1.101, libavutil >= 61.1.101
Requires.private: 
Conflicts:
