     if (!proto_name)
         proto_name = avio_find_protocol_name(url);
 
-    if (!proto_name)
-        return AVERROR_INVALIDDATA;
+    if (!proto_name) {
+        /* a custom io_open can handle schemes with no registered
+           URLProtocol (e.g. an external TLS stack) — derive the scheme
