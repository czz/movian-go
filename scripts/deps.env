# deps.env — canonical third-party dependency manifest (Fase 9.1).
# Sourced by scripts/build_*.sh. Every entry records name, version,
# official source URL and SHA-256 of the release artifact.
# All values are defaults: callers may override via environment.

# ---- FFmpeg (all targets) -------------------------------------------------
FFMPEG_VERSION="${FFMPEG_VERSION:-9.0.1}"
FFMPEG_TARBALL="ffmpeg-${FFMPEG_VERSION}.tar.xz"
FFMPEG_URL="https://ffmpeg.org/releases/${FFMPEG_TARBALL}"
# sha256 of the official ffmpeg release tarball (ffmpeg.org).
FFMPEG_SHA256="cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635"
# FFmpeg configure/build flags live in each platform script (unchanged).

# ---- zlib (Windows vendored dep) -------------------------------------------
ZLIB_VERSION="${ZLIB_VERSION:-1.3.1}"
ZLIB_TARBALL="zlib-${ZLIB_VERSION}.tar.xz"
ZLIB_URL="https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/${ZLIB_TARBALL}"
# sha256 per zlib.net release checksum.
ZLIB_SHA256="38ef96b8dfe510d42707d9c781877914792541133e1870841463bfa73f883e32"

# ---- GLFW (Windows vendored dep) -------------------------------------------
GLFW_VERSION="${GLFW_VERSION:-3.4}"
GLFW_TARBALL="glfw-${GLFW_VERSION}.zip"
GLFW_URL="https://github.com/glfw/glfw/releases/download/${GLFW_VERSION}/${GLFW_TARBALL}"
# sha256 per FreeBSD distinfo record for the GitHub release zip.
GLFW_SHA256="b5ec004b2712fd08e8861dc271428f048775200a2df719ccf575143ba749a3e9"

# ---- libxml2 (Android/Windows vendored dep) ---------------------------------
# Enables FFmpeg's DASH demuxer (dash_demuxer_deps="libxml2") — on Linux the
# system libxml2-dev is used; Android/Windows cross-builds need a vendored
# static copy. The MPD parser only needs the reader/tree, so the vendored
# build disables python/zlib/lzma/iconv/http/ftp.
LIBXML2_VERSION="${LIBXML2_VERSION:-2.12.10}"
LIBXML2_TARBALL="libxml2-${LIBXML2_VERSION}.tar.xz"
LIBXML2_URL="https://download.gnome.org/sources/libxml2/2.12/${LIBXML2_TARBALL}"
# sha256 per official libxml2-2.12.10.sha256sum on download.gnome.org.
LIBXML2_SHA256="c3d8c0c34aa39098f66576fe51969db12a5100b956233dc56506f7a8679be995"

# ---- FreeType (Android/Windows vendored dep) --------------------------------
FREETYPE_VERSION="${FREETYPE_VERSION:-2.13.3}"
FREETYPE_TARBALL="freetype-${FREETYPE_VERSION}.tar.xz"
FREETYPE_URL="https://download.savannah.gnu.org/releases/freetype/${FREETYPE_TARBALL}"
# sha256 per ft-announce / SourceForge release checksums.
FREETYPE_SHA256="0550350666d427c74daeb85d5ac7bb353acba5f76956395995311a9c6f063289"

# ---- SQLite -----------------------------------------------------------------
# No longer vendored — the DB layer uses modernc.org/sqlite (Go module,
# version pinned in go.mod) on every platform.

# License references: FFmpeg LGPL-2.1+/GPL-2.0+ (build flags select),
# zlib (Zlib license), GLFW (Zlib), FreeType (FTL/GPL-2.0). modernc.org/sqlite
# (BSD-3 + SQLite public domain) is fetched via go.mod — see module docs.
