# AndroidX WebKit for the Android WebView popup (WebPopupActivity).
# Kept apart from deps.env: a change there rebuilds the native deps (~25 min),
# and this jar only feeds javac and d8.
ANDROIDX_WEBKIT_VERSION="1.14.0"
ANDROIDX_WEBKIT_AAR="webkit-${ANDROIDX_WEBKIT_VERSION}.aar"
ANDROIDX_WEBKIT_URL="https://dl.google.com/dl/android/maven2/androidx/webkit/webkit/${ANDROIDX_WEBKIT_VERSION}/${ANDROIDX_WEBKIT_AAR}"
ANDROIDX_WEBKIT_SHA256="265604786ea1c9679e3f860f7f13072375c141f46db9092ed8ef5ecd599a516d"
