prefix=/tmp/movian-go/third_party/libva/usr
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

libva_version=2.22.0
va_api_version=1.22.0
display=glx

Name: va-glx
Description: Userspace Video Acceleration (VA) GLX interface
Version: 1.22.0
Requires: libva
Libs: -L${libdir} -lva-glx
Cflags: -I${includedir}
