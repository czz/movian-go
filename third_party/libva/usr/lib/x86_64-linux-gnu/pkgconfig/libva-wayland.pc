prefix=/tmp/movian-go/third_party/libva/usr
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

libva_version=2.22.0
va_api_version=1.22.0
display=wayland

Name: va-wayland
Description: Userspace Video Acceleration (VA) Wayland interface
Version: 1.22.0
Requires: libva, wayland-client
Libs: -L${libdir} -lva-wayland
Cflags: -I${includedir}
