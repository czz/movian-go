    <!-- Launcher mode: this alias carries the HOME/DEFAULT filter so
         Movian is offered as a home-app candidate ONLY while launcher
         mode is on — the alias stays disabled otherwise.
         priority=10: out-ranks typical OEM home filters (e.g. the TIM
         launcher pins itself at priority=2). Positive priorities are
         only honoured for system/priv apps — AOSP clamps them to 0 for
         third-party packages — so this helps when Movian is installed
         as a system app (e.g. appliance builds); on locked operator
         firmware no third-party app can win HOME anyway. -->
    <activity-alias android:name=".HomeLauncher"
                    android:enabled="false"
                    android:exported="true"
                    android:label="@@APPNAME@@"
                    android:icon="@drawable/ic_launcher"
                    android:targetActivity=".GLWActivity">
      <intent-filter android:priority="10">
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity-alias>

    <!-- Launcher mode on locked firmware: accessibility service that
         consumes the HOME key before the system resolves it and brings
         GLWActivity to front. Enabled via Settings > Accessibility, or
         automatically when WRITE_SECURE_SETTINGS was granted via
         `pm grant`. Inert while the .HomeLauncher alias is disabled. -->
    <service android:name=".HomeKeyService"
             android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
             android:exported="true">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice"
                 android:resource="@xml/accessibility_service_config" />
    </service>

