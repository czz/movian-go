.deps/

# Built dependency artifacts — reproducible via scripts/build_*.sh
# (sources verified against scripts/deps.env SHA-256). Headers stay
# tracked (cgo CFLAGS -I needs them at compile time).
ffmpeg/ffmpeg-*/
ffmpeg/lib/*.a
ffmpeg/android/**/lib/*.a
ffmpeg/windows/**/lib/*.a
ffmpeg/rpi/

# RPi cross sysroot (regenerated by scripts/build_ffmpeg_rpi.sh)
third_party/rpi/sysroot/
third_party/**/*.a
third_party/**/*.o
third_party/freetype/wasm/work/
internal/backend/dvd/dvdlib/wasm/build/

# Extra .so bundled into the APK (built by build_ffmpeg_android.sh --shared)
android/vendorlibs/
ffmpeg/android/*-shared/

# strays — object files never belong in the tree (libav_avio.o was
# accidentally committed once)
*.o
cmd/movian-go/*.syso
"Movian Go.app/"
/libcore_*.so
# test files live only in the local working tree
*_test.go
third_party/cef/
third_party/libxml2/
third_party/glfw/linux/
third_party/zlib/windows/386/
third_party/glfw/windows/386/
android/movian.keystore
/dist/
